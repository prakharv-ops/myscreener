{
  "name": "myscreener",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ingest": "tsx --env-file=.env.local scripts/ingest.mts",
    "alerts": "tsx --env-file-if-exists=.env.local scripts/run-alerts.mts",
    "refresh": "npm run universe && npm run global && npm run quotes && npm run enrich -- --refill --minutes 90 && npm run dedupe && npm run rescore && npm run alerts",
    "rescore": "tsx --env-file-if-exists=.env.local scripts/rescore.mts",
    "universe": "tsx --env-file-if-exists=.env.local scripts/sync-universe.mts",
    "quotes": "tsx --env-file-if-exists=.env.local scripts/quotes.mts",
    "enrich": "tsx --env-file-if-exists=.env.local scripts/enrich.mts",
    "global": "tsx --env-file-if-exists=.env.local scripts/sync-global.mts",
    "dedupe": "tsx --env-file-if-exists=.env.local scripts/dedupe-listings.mts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-table": "^9.3.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yahoo-finance2": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}

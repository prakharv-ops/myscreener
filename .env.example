SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# Email alerts (Resend, https://resend.com). Leave unset to disable.
RESEND_API_KEY=re_xxx
ALERT_EMAIL_TO=you@example.com            # comma-separated for several
ALERT_EMAIL_FROM=MyScreener <alerts@yourdomain.com>   # default uses Resend's onboarding sender (only delivers to your own Resend account email)
# Protects /api/alerts/run in production (send as Bearer token)
# CRON_SECRET=

# Live prices. Without a key, every market uses Yahoo polling (free, ~5s). With a free Finnhub key
# (https://finnhub.io/register), US stocks on screen stream over WebSocket instead.
# FINNHUB_API_KEY=
# LIVE_WS_CAP=30       # max symbols on the Finnhub WebSocket (free tier allows ~30-50)
# LIVE_POLL_MS=5000    # Yahoo polling interval

# Outgoing webhooks for alerts: Slack / Discord incoming-webhook URLs, or any HTTPS endpoint (Zapier, n8n, your server).
# Generic endpoints get signed JSON: X-MyScreener-Signature: sha256=<hmac of body using the secret>
# ALERT_WEBHOOK_URLS=https://hooks.slack.com/services/XXX,https://example.com/hook
# ALERT_WEBHOOK_SECRET=

# Login (required in production). APP_SECRET signs session cookies: any long random string.
# APP_PASSWORD=
# APP_SECRET=
